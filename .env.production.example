# COOLIFY: enter these values in the application's Environment Variables UI (see deploy/COOLIFY.md), not in a file.
# Also set there: NODE_ENV=production, PORT=3000, PGSSL=false, HTTP_KEEP_ALIVE_TIMEOUT_MS=120000 (above Traefik's and
# cloudflared's idle timeouts), PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE from the Coolify Postgres resource
# (internal host name, port 5432), REDIS_HOST/REDIS_PORT from the Coolify Redis resource (internal host, 6379).
# The engine has NO Redis password setting (only REDIS_HOST and REDIS_PORT): see deploy/COOLIFY.md step 4.
# The TUNNEL_TOKEN and BACKUP_* blocks at the bottom are for the plain-Compose path only; skip them on Coolify.
#
# Production settings for the engine (docker-compose.prod.yml). Copy to .env.production, chmod 600, fill the blanks.
# Never commit .env.production. Values below that are not blank are the production choices.
#
# Set by docker-compose.prod.yml, do NOT set here (the compose file overrides them):
#   NODE_ENV, PORT, PGHOST, PGPORT, PGSSL, REDIS_HOST, REDIS_PORT, HTTP_KEEP_ALIVE_TIMEOUT_MS
#
# Not needed without the Telegram bot (the bot is out of scope for this deployment): EVENTS_PROVIDER,
# SUGGESTIONS_CRON, WIZARD_QUESTIONS_PATH. The engine boots without them: EVENTS_PROVIDER defaults to
# "mock" (the only provider that exists; it is NOT blocked by NODE_ENV=production) and SUGGESTIONS_CRON
# defaults to "0 9 * * *". The daily suggestions run finds no trips with a chat (app trips have none),
# so it does nothing. Leave both unset.

# --- Database (Postgres container in the same Compose project) ---------------
# Used by the engine and, interpolated, to create the postgres container (POSTGRES_USER/PASSWORD/DB).
# The password is only set when the data volume is first created: change it later inside Postgres, not here.
PGUSER=holiday
PGPASSWORD=
PGDATABASE=holiday
# Never true in production: migrations run on boot (migrationsRun), the schema is not synchronized.
DB_SYNCHRONIZE=false

# --- App API auth ------------------------------------------------------------
# Google OAuth client ids allowed as ID token audience (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=
# HS256 secret, at least 32 characters (`openssl rand -base64 48`). Changing it signs everyone out.
JWT_SECRET=
# Startup fails if this is true in production.
DEV_LOGIN_ENABLED=false
ENGINE_PUBLIC_URL=https://holidai.waygex.com
APP_INVITE_BASE_URL=https://holidai.waygex.com

# --- Email (invites, countdowns) ---------------------------------------------
MAIL_PROVIDER=resend
RESEND_API_KEY=
# An address on a domain verified in Resend.
MAIL_FROM=
MAIL_FROM_NAME=Holid.ai
MAIL_REPLY_TO=

# --- AI trip planning --------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only when the API key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# Defaults to claude-sonnet-5-5.
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=4096
AI_EFFORT=low
AI_FALLBACKS=default
FREE_AI_MESSAGES_PER_DAY=10
FREE_TRIP_PLACES_LIMIT=15

# --- Places ------------------------------------------------------------------
PLACES_PROVIDER=google
# Server key restricted to the Places API (New).
GOOGLE_PLACES_API_KEY=

# --- Billing (RevenueCat) ----------------------------------------------------
BILLING_PROVIDER=revenuecat
REVENUECAT_SECRET_API_KEY=
# Same value as the Authorization header configured on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=plus

# --- Moments photo storage (Cloudflare R2, private bucket) -------------------
STORAGE_DRIVER=s3
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
# Token scoped to the moments bucket: object read, write and delete (see deploy/RUNBOOK.md).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FREE_MOMENTS_PER_TRIP=50
PLUS_MOMENTS_PER_TRIP=1000

# --- Notifications -----------------------------------------------------------
PUSH_PROVIDER=expo
# Needed when "enhanced push security" is on in Expo.
EXPO_ACCESS_TOKEN=
NOTIFICATIONS_SEND_HOUR=9

# --- Home tab ----------------------------------------------------------------
HOME_WEATHER_CACHE_MINUTES=30
# Nightly AI copy refresh (spends Anthropic tokens).
HOME_COPY_AI_REFRESH=false
HOME_COPY_AI_MAX_PER_NIGHT=300

# --- Cloudflare Tunnel (read by the cloudflared container) -------------------
# Zero Trust > Networks > Tunnels > your tunnel > token. Public hostname holidai.waygex.com, path app/v1 -> http://engine:3000
TUNNEL_TOKEN=

# --- Image tag (optional) ----------------------------------------------------
# ENGINE_TAG=latest

# --- Backups (read by deploy/backup.sh) --------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Leave BACKUP_S3_BUCKET empty to keep dumps on the server only (a warning is printed).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# A SEPARATE R2 token scoped to the backup bucket only (object write).
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
