PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
PGHOST=localhost
PGPORT=5432
PGUSER=holiday
PGPASSWORD=holiday
PGDATABASE=holiday
PGSSL=false
DB_SYNCHRONIZE=false
EVENTS_PROVIDER=mock
# Daily scheduled event suggestions (cron, UTC)
SUGGESTIONS_CRON="0 9 * * *"
# App API auth. Google OAuth client ids allowed as ID token audience (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=
# HS256 secret for access tokens, at least 32 characters (e.g. `openssl rand -base64 48`). Required.
JWT_SECRET=
# DEV ONLY, never in production: enables POST /app/v1/auth/dev (sign in with just an email, for Expo Go).
# Startup fails if it's true with NODE_ENV=production.
DEV_LOGIN_ENABLED=false
# Optional: wizard question set file (defaults to the bundled src/wizard/questions.json)
WIZARD_QUESTIONS_PATH=
# App invite links: <base>/invite/<token> (default https://holid.ai)
APP_INVITE_BASE_URL=https://holid.ai

# --- Email (invite emails) ---------------------------------------------------
# Which provider sends email: log (default: sends nothing, logs the subject; body at debug without links), smtp or mailjet.
# Startup fails if the chosen provider is missing a setting below, or if the name is unknown.
MAIL_PROVIDER=log
# Sender address (required for smtp and mailjet; must be a sender/domain verified with the provider).
MAIL_FROM=
# Sender name (default "Holid.ai") and an optional Reply-To address.
MAIL_FROM_NAME=Holid.ai
MAIL_REPLY_TO=
# true: check the SMTP connection at startup and fail boot if it doesn't work. false (default): check on the first send.
# Only true or false are accepted. Nothing to check for log or mailjet.
MAIL_VERIFY_ON_BOOT=false

# MAIL_PROVIDER=smtp: any SMTP relay (Mailjet, SendGrid, Amazon SES, ...). The connection is checked on the first send, not at startup.
# SMTP_PORT defaults to 587; SMTP_SECURE=false (default) upgrades with STARTTLS, true is TLS from the start (usually port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Ready-to-fill Mailjet over SMTP (API key as user, secret key as password):
# MAIL_PROVIDER=smtp
# MAIL_FROM=trips@your-verified-domain.com
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<Mailjet API key>
# SMTP_PASS=<Mailjet secret key>

# MAIL_PROVIDER=mailjet: Mailjet's HTTP Send API v3.1 (no SMTP needed). Ready to fill:
# MAIL_PROVIDER=mailjet
# MAIL_FROM=trips@your-verified-domain.com
MAILJET_API_KEY=
MAILJET_API_SECRET=
