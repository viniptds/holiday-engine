PORT=3000
# HTTP keep-alive (ms, whole number, at least 1000; default 65000). Keep it above the idle timeout of any
# load balancer or proxy in front (AWS ALB 60 s), or clients get sporadic resets/502s. headersTimeout is
# set to this + 1000. An invalid value fails startup.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
REDIS_HOST=localhost
REDIS_PORT=6379
PGHOST=localhost
PGPORT=5432
PGUSER=holiday
PGPASSWORD=holiday
PGDATABASE=holiday
PGSSL=false
DB_SYNCHRONIZE=false
EVENTS_PROVIDER=mock
# Daily scheduled event suggestions (cron, UTC)
SUGGESTIONS_CRON="0 9 * * *"
# App API auth. Google OAuth client ids allowed as ID token audience (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=
# HS256 secret for access tokens, at least 32 characters (e.g. `openssl rand -base64 48`). Required.
JWT_SECRET=
# DEV ONLY, never in production: enables POST /app/v1/auth/dev (sign in with just an email, for Expo Go).
# Only takes effect with NODE_ENV=development (or test); with NODE_ENV unset or anything else it's
# ignored (fails closed), and startup fails if it's true with NODE_ENV=production. For local dev login:
#   NODE_ENV=development
#   DEV_LOGIN_ENABLED=true
DEV_LOGIN_ENABLED=false
# Optional: wizard question set file (defaults to the bundled src/wizard/questions.json)
WIZARD_QUESTIONS_PATH=
# App invite links: <base>/invite/<token> (default https://holid.ai)
APP_INVITE_BASE_URL=https://holid.ai

# --- Email (invite emails) ---------------------------------------------------
# Which provider sends email: log (default: sends nothing, logs the subject; body at debug without links), smtp or mailjet.
# Startup fails if the chosen provider is missing a setting below, or if the name is unknown.
MAIL_PROVIDER=log
# Sender address (required for smtp and mailjet; must be a sender/domain verified with the provider).
MAIL_FROM=
# Sender name (default "Holid.ai") and an optional Reply-To address.
MAIL_FROM_NAME=Holid.ai
MAIL_REPLY_TO=
# true: check the SMTP connection at startup and fail boot if it doesn't work. false (default): check on the first send.
# Only true or false are accepted. Nothing to check for log or mailjet.
MAIL_VERIFY_ON_BOOT=false

# MAIL_PROVIDER=smtp: any SMTP relay (Mailjet, SendGrid, Amazon SES, ...). The connection is checked on the first send, not at startup.
# SMTP_PORT defaults to 587; SMTP_SECURE=false (default) upgrades with STARTTLS, true is TLS from the start (usually port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Ready-to-fill Mailjet over SMTP (API key as user, secret key as password):
# MAIL_PROVIDER=smtp
# MAIL_FROM=trips@your-verified-domain.com
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<Mailjet API key>
# SMTP_PASS=<Mailjet secret key>

# MAIL_PROVIDER=mailjet: Mailjet's HTTP Send API v3.1 (no SMTP needed). Ready to fill:
# MAIL_PROVIDER=mailjet
# MAIL_FROM=trips@your-verified-domain.com
MAILJET_API_KEY=
MAILJET_API_SECRET=

# AI trip planning (docs/app-ai-spec.md). AI_PROVIDER: anthropic | openai | mock (mock fails startup in production).
AI_PROVIDER=mock
# Defaults to claude-sonnet-5-5 for anthropic; required for openai.
AI_MODEL=
# Key of the selected provider. Startup fails if it's missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Per provider call, in ms
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=4096
# Anthropic output_config.effort: low | medium | high | xhigh | max. Empty: not sent (models without effort, e.g. Haiku 4.5).
AI_EFFORT=low
# Anthropic server-side fallbacks on refusal: default | off (off sends neither the field nor its beta header)
AI_FALLBACKS=default
# Place verification: google | mock (mock fails startup in production)
PLACES_PROVIDER=mock
# Server key restricted to the Places API (New), separate from the OAuth clients. Required for google.
GOOGLE_PLACES_API_KEY=
