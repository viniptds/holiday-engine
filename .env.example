PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
PGHOST=localhost
PGPORT=5432
PGUSER=holiday
PGPASSWORD=holiday
PGDATABASE=holiday
PGSSL=false
DB_SYNCHRONIZE=false
EVENTS_PROVIDER=mock
# Daily scheduled event suggestions (cron, UTC)
SUGGESTIONS_CRON="0 9 * * *"
# App API auth. Google OAuth client ids allowed as ID token audience (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=
# HS256 secret for access tokens, at least 32 characters (e.g. `openssl rand -base64 48`). Required.
JWT_SECRET=
# DEV ONLY, never in production: enables POST /app/v1/auth/dev (sign in with just an email, for Expo Go).
# Startup fails if it's true with NODE_ENV=production.
DEV_LOGIN_ENABLED=false
# Optional: wizard question set file (defaults to the bundled src/wizard/questions.json)
WIZARD_QUESTIONS_PATH=
# App invite links: <base>/invite/<token> (default https://holid.ai)
APP_INVITE_BASE_URL=https://holid.ai
# AI trip planning (docs/app-ai-spec.md). AI_PROVIDER: anthropic | openai | mock (mock fails startup in production).
AI_PROVIDER=mock
# Defaults to claude-sonnet-5-5 for anthropic; required for openai.
AI_MODEL=
# Key of the selected provider. Startup fails if it's missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Per provider call, in ms
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=4096
# Anthropic output_config.effort: low | medium | high | xhigh | max
AI_EFFORT=low
# Place verification: google | mock (mock fails startup in production)
PLACES_PROVIDER=mock
# Server key restricted to the Places API (New), separate from the OAuth clients. Required for google.
GOOGLE_PLACES_API_KEY=
